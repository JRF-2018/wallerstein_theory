@mext 1
theory: kant.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
review "%芸術に規則を与える生得的な心的資質" doubtful  ; 事実は「新しい記号体系を与えた」という成果であり、定義の「生得的な心的資質」そのものではない。また記号体系は概念的な規則で、カントが天才の与える規則（概念として定式化できない範例的規則、§46-47）と区別するものに近い
review "%それ自体に目的を持たないにもかかわらず合目的的に感じられること" reject  ; 試算: 対象のずれ（拳譜≠プロジェクト）を重く見て、不成立の根拠を外す。
review "%多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない" reject  ; 試算: 分類≠概念による完全な規定として、不成立の根拠を外す
; 元の判断: 事実の主語は「拳譜」で、主張の対象「SHEET_BOXINGプロジェクト」ではない（対象のずれ）。また外的な目的を持つことは付属美（§16）にとどまる理由にはなるが、芸術美は概念・目的を前提しうる（§48）ので、目的の存在から直ちに不成立とはいえない
; 元の判断: 「ノーテーションの1類型と説明できる」はジャンルへの分類にすぎず、その表象が概念によって「完全に」規定されること（美的理念の否定、§49）までは導けない。飛躍は大きいが、著者の含意（意義が記譜という概念で尽きる）を読めば争いうる範囲として doubtful

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
E1*: -"#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判", "SHEET_BOXINGプロジェクトはアートではない", "%天才によって規則を生み出したこと", -"%目的なき合目的性が備えていること", -"%美的理念を有する", -"? 美しい芸術とは"

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判"  ; L1
q1     issue  "SHEET_BOXINGプロジェクトはアートといえるか／? 美しい芸術とは"  ; L1
y1     reason "天才によって規則を生み出し、目的なき合目的性が備え、美的理念を有する表象である"  ; L2
r1     req    "SHEET_BOXINGプロジェクトはアートといえるか／%天才によって規則を生み出したこと"  ; L3
q2     issue  "SHEET_BOXINGプロジェクトはアートといえるか／? 天才とは"  ; L4
r2     req    "SHEET_BOXINGプロジェクトはアートといえるか／%芸術に規則を与える生得的な心的資質"  ; L5
f1     fact   "ボクシングの戦術表現につき新しい記号体系を与えた"  ; L6
r3     req    "SHEET_BOXINGプロジェクトはアートといえるか／%目的なき合目的性が備えていること"  ; L7
r4     req    "SHEET_BOXINGプロジェクトはアートといえるか／%それ自体に目的を持たないにもかかわらず合目的的に感じられること"  ; L8
f2     fact   "拳譜は、ボクシングの戦術的側面を記録し議論するという目的を持っている"  ; L9
r5     req    "SHEET_BOXINGプロジェクトはアートといえるか／%美的理念を有する"  ; L11
r6     req    "SHEET_BOXINGプロジェクトはアートといえるか／%多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない"  ; L12
f3     fact   "ノーテーションの1類型であると説明できる"  ; L13
x1     aux    "（L2 の AND・3項・1）"  ; L2
c1     concl  "SHEET_BOXINGプロジェクトはアートではない"  ; L15

[W]
f1, f2, f3

[rules]
r1: f1 -> r2  ; L5 %芸術に規則を与える生得的な心的資質（AI: 疑わしい）
r2: -f1 -> -r2  ; L5 %芸術に規則を与える生得的な心的資質（AI: 疑わしい）（必要条件の否定）
r3: r2 -> q2  ; L4 論点「天才とは」
r4: -r2 -> -q2  ; L4 論点「天才とは」（必要条件の否定）
r5: q2 -> r1  ; L3 %天才によって規則を生み出したこと
r6: -q2 -> -r1  ; L3 %天才によって規則を生み出したこと（必要条件の否定）
r7: r4 -> r3  ; L7 %目的なき合目的性が備えていること
r8: -r4 -> -r3  ; L7 %目的なき合目的性が備えていること（必要条件の否定）
r9: r6 -> r5  ; L11 %美的理念を有する
r10: -r6 -> -r5  ; L11 %美的理念を有する（必要条件の否定）
r11: r1 & r3 & r5 -> x1  ; AND
r12: -r1 -> -x1  ; AND（必要条件の否定）
r13: -r3 -> -x1  ; AND（必要条件の否定）
r14: -r5 -> -x1  ; AND（必要条件の否定）
r15: y1 & x1 -> q1  ; L1 論点「美しい芸術とは」
r16: -y1 -> -q1  ; L1 論点「美しい芸術とは」（必要条件の否定）
r17: -x1 -> -q1  ; L1 論点「美しい芸術とは」（必要条件の否定）
r18: -q1 -> -k1  ; L1 要件の否定による主張 L1 の不成立

[defaults]
y1: ⊤ : y1 / y1  ; reason L2 理由（論証の前提として受け入れる）
L1: q1 : k1 / k1  ; claim L1 主張 ^カントの判断力批判
L1.不成立: ⊤ : -k1, c1 / c1  ; failure L15 主張 L1 が成立しないことからの結論

[priority]
L1 > L1.不成立

[extensions]
; 衝突しうるデフォルト: なし
E1 preferred:
  generating: y1, L1.不成立
  literals: y1, r1, q2, r2, f1, f2, f3, c1

[marks]
+ r2     L5 %芸術に規則を与える生得的な心的資質  ; E1:一致
+ r1     L3 %天才によって規則を生み出したこと  ; E1:一致
! r3     L7 %目的なき合目的性が備えていること  ; E1:一致
! r5     L11 %美的理念を有する  ; E1:一致

[summary]
extensions: 1 (preferred: 1)
skeptical: c1
credulous: c1
; 注: AI の審査で棄却されたあてはめ: SHEET_BOXINGプロジェクトはアートといえるか／%それ自体に目的を持たないにもかかわらず合目的的に感じられること <= 拳譜は、ボクシングの戦術的側面を記録し議論するという目的を持っている
; 注: AI の審査で棄却されたあてはめ: SHEET_BOXINGプロジェクトはアートといえるか／%多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない <= ノーテーションの1類型であると説明できる
