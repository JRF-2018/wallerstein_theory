@mext 1
theory: theft_fail.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
neg "#窃盗罪^刑法第235条 [L1]" "甲に窃盗罪は成立しない"   ; 主張 L1 は「甲の本件行為に窃盗罪が成立する」の意であり、結論 L16 はその否定にほかならない
review "A@占有者" doubtful   ; 事実「A」は人名だけで事実ではない。A が占有者だという評価の実質的根拠は L6 の事実群（v2）にあり、ここ単独では飛躍。しかも要件「占有者の意思に反して」には A の不同意の事実が必要だが書かれていない
review "（L6 の事実群）@Aが財布を実力的に支配している" doubtful   ; 公園のベンチに置き約20m・5分で戻った事情は、最決平成16年8月25日（約27m・約2分で占有肯定）の射程に近いが、時間がやや長く、置き忘れか意図的に置いたかも不明で、占有の有無は争いうる
review "甲@自己" ok   ; 移転先が行為者甲自身であるという評価で、飛躍はない
review "持ち去った@移転" ok   ; 持ち去りにより財布の事実的支配が甲に移ったと評価するのは通常のあてはめ
review "持ち去った@権利者Aを排除して" ok   ; 持ち去りはAの利用可能性を奪うもので、権利者排除意思の徴表として通常の評価（ただし一時使用目的なら争いうるが、本件はいやがらせ目的で返還意思の記載なし）
review "いやがらせをする目的だった@財布そのものから効用を得るわけではない" ok   ; 毀棄・隠匿目的の場合に利用処分意思を否定する判例（大判大正4年5月21日、教育勅語事件）に沿った評価。ただし事後に財布を使った事情があれば覆る

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
E1*: -"#窃盗罪^刑法第235条 [L1]", -"窃盗罪／%経済的用法に従って利用処分する意思", "窃盗罪／「他人の財物」", "窃盗罪／「窃取」", "窃盗罪／%故意"

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#窃盗罪^刑法第235条 [L1]"  ; L1,L16
f1     fact   "甲が本件財布を持ち去った行為"  ; L1
r1     req    "窃盗罪／「他人の財物」"  ; L2
r2     req    "窃盗罪／%他人が所有する財産的価値のある有体物"  ; L2
f2     fact   "本件財布はAが所有する"  ; L2
r3     req    "窃盗罪／「窃取」"  ; L3
r4     req    "窃盗罪／%占有者の意思に反して占有を自己又は第三者に移転すること"  ; L3
r5     req    "窃盗罪／%占有者の意思に反して"  ; L4
f3     fact   "A"  ; L4
v1     eval   "A@占有者"  ; L4
r6     req    "窃盗罪／%占有"  ; L5
r7     req    "窃盗罪／%人が物を実力的に支配する関係"  ; L5
f4     fact   "公園のベンチにおいていた"  ; L6
f5     fact   "最大20メートル離れて5分後に取りに戻った"  ; L6
x1     aux    "（L6 の AND・2項・1）"  ; L6
v2     eval   "（L6 の事実群）@Aが財布を実力的に支配している"  ; L6
r8     req    "窃盗罪／%自己又は第三者に移転"  ; L8
f6     fact   "甲"  ; L8
v3     eval   "甲@自己"  ; L8
f7     fact   "持ち去った"  ; L8,L12
v4     eval   "持ち去った@移転"  ; L8
x2     aux    "（L8 の AND・2項・1）"  ; L8
x3     aux    "（L3 の AND・3項・1）"  ; L3
r9     req    "窃盗罪／%故意"  ; L10
r10    req    "窃盗罪／%事実の認識・認容"  ; L10
f8     fact   "甲は前記事実を認識認容している"  ; L10
r11    req    "窃盗罪／%不法領得の意思"  ; L11
r12    req    "窃盗罪／%権利者を排除して他人の物を自己の所有物とし"  ; L12
v5     eval   "持ち去った@権利者Aを排除して"  ; L12
r13    req    "窃盗罪／%経済的用法に従って利用処分する意思"  ; L13
f9     fact   "いやがらせをする目的だった"  ; L13
v6     eval   "いやがらせをする目的だった@財布そのものから効用を得るわけではない"  ; L13
x4     aux    "（L11 の AND・2項・1）"  ; L11
x5     aux    "（L1 の AND・4項・1）"  ; L1

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9

[rules]
r1: f2 -> r2  ; L2 %他人が所有する財産的価値のある有体物
r2: r2 -> r1  ; L2 「他人の財物」
r3: v1 -> r5  ; L4 %占有者の意思に反して
r4: f4 & f5 -> x1  ; AND
r5: v2 -> r7  ; L5 %人が物を実力的に支配する関係
r6: r7 -> r6  ; L5 %占有
r7: v3 & v4 -> x2  ; AND
r8: x2 -> r8  ; L8 %自己又は第三者に移転
r9: r5 & r6 & r8 -> x3  ; AND
r10: x3 -> r4  ; L3 %占有者の意思に反して占有を自己又は第三者に移転すること
r11: r4 -> r3  ; L3 「窃取」
r12: f8 -> r10  ; L10 %事実の認識・認容
r13: r10 -> r9  ; L10 %故意 ^38条1項本文
r14: v5 -> r12  ; L12 %権利者を排除して他人の物を自己の所有物とし
r15: v6 -> -r13  ; L13 %経済的用法に従って利用処分する意思（不成立の根拠）
r16: r12 & r13 -> x4  ; AND
r17: x4 -> r11  ; L11 %不法領得の意思
r18: r1 & r3 & r9 & r11 -> x5  ; AND

[defaults]
e1: f3 : v1 / v1  ; eval L4 評価 @占有者（AI: 疑わしい）
e2: x1 : v2 / v2  ; eval L6 評価 @Aが財布を実力的に支配している（AI: 疑わしい）
e3: f6 : v3 / v3  ; eval L8 評価 @自己
e4: f7 : v4 / v4  ; eval L8 評価 @移転
e5: f7 : v5 / v5  ; eval L12 評価 @権利者Aを排除して
e6: f9 : v6 / v6  ; eval L13 評価 @財布そのものから効用を得るわけではない
L1: f1, x5 : k1 / k1  ; claim L1 主張 ^刑法第235条
L1.不成立: ⊤ : -k1, -k1 / -k1  ; failure L16 主張 L1 が成立しないことからの結論

[priority]

[extensions]
; 衝突しうるデフォルト: L1
E1:
  generating: e1, e2, e3, e4, e5, e6, L1.不成立
  literals: -k1, f1, r1, r2, f2, r3, r4, r5, f3, v1, r6, r7, f4, f5, x1, v2, r8, f6, v3, f7, v4, x2, x3, r9, r10, f8, r12, v5, -r13, f9, v6

[marks]
+ r1     L2 「他人の財物」  ; E1:一致
+ r5     L4 %占有者の意思に反して  ; E1:一致
+ r6     L5 %占有  ; E1:一致
+ r8     L8 %自己又は第三者に移転  ; E1:一致
+ r3     L3 「窃取」  ; E1:一致
+ r9     L10 %故意  ; E1:一致
+ r12    L12 %権利者を排除して他人の物を自己の所有物とし  ; E1:一致
! r13    L13 %経済的用法に従って利用処分する意思  ; E1:一致
! r11    L11 %不法領得の意思  ; E1:一致
! k1     L1 #窃盗罪  ; E1:一致

[summary]
extensions: 1
skeptical: -k1
credulous: -k1
