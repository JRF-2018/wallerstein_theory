@mext 1
theory: kant.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
neg "#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判 [L1]" "SHEET_BOXINGプロジェクトはアートではない"  ; 主張は「アートといえるか」という問いで、結論はその否定の答え。結論を主張の否定と同一視する（主張の肯定＝「アートといえる」）
; same: 該当なし（同じ命題の別表記は見当たらない）
; failure/effect: 既定の読み（L15 の結論を主張 L1 の不成立からの帰結と読む）は正しいので書かない
; review: 評価（@）の原子がないので該当なし。あてはめの飛躍はレポート 6 章で論じる
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2
rule -"SHEET_BOXINGプロジェクトはアートといえるか／%それ自体に目的を持たないにもかかわらず合目的的に感じられること" -> -"SHEET_BOXINGプロジェクトはアートといえるか／%目的なき合目的性が備えていること"  ; L8 は L7 の定義（言い換え）なので、定義の不成立は被定義項の不成立。mext.py は r4 -> r3 だけを作り、-r4 から -r3 を作らない
rule -"SHEET_BOXINGプロジェクトはアートといえるか／%多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない" -> -"SHEET_BOXINGプロジェクトはアートといえるか／%美的理念を有する"  ; L12 は L11 の定義なので同上
rule -"SHEET_BOXINGプロジェクトはアートといえるか／%目的なき合目的性が備えていること" -> -"#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判 [L1]"  ; L2 の ~> は「美しい芸術」の定義（3要件の連言）で、各要件は必要条件。mext.py は ~> の内容を原子にしていない（落ちている）ので、必要条件であることをここで補う
rule -"SHEET_BOXINGプロジェクトはアートといえるか／%美的理念を有する" -> -"#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判 [L1]"  ; 同上（第3要件の必要条件性）

[claimed]
E1*: -"#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判 [L1]", "SHEET_BOXINGプロジェクトはアートといえるか／%天才によって規則を生み出したこと", -"SHEET_BOXINGプロジェクトはアートといえるか／%目的なき合目的性が備えていること", -"SHEET_BOXINGプロジェクトはアートといえるか／%美的理念を有する"

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#SHEET_BOXINGプロジェクトはアートといえるか^カントの判断力批判 [L1]"  ; L1,L15
r1     req    "SHEET_BOXINGプロジェクトはアートといえるか／%天才によって規則を生み出したこと"  ; L3
r2     req    "SHEET_BOXINGプロジェクトはアートといえるか／%芸術に規則を与える生得的な心的資質"  ; L5
f1     fact   "ボクシングの戦術表現につき新しい記号体系を与えた"  ; L6
r3     req    "SHEET_BOXINGプロジェクトはアートといえるか／%目的なき合目的性が備えていること"  ; L7
r4     req    "SHEET_BOXINGプロジェクトはアートといえるか／%それ自体に目的を持たないにもかかわらず合目的的に感じられること"  ; L8
f2     fact   "拳譜は、ボクシングの戦術的側面を記録し議論するという目的を持っている"  ; L9
r5     req    "SHEET_BOXINGプロジェクトはアートといえるか／%美的理念を有する"  ; L11
r6     req    "SHEET_BOXINGプロジェクトはアートといえるか／%多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない"  ; L12
f3     fact   "ノーテーションの1類型であると説明できる"  ; L13
x1     aux    "（L2 の AND・3項・1）"  ; L2

[W]
f1, f2, f3

[rules]
r1: f1 -> r2  ; L5 %芸術に規則を与える生得的な心的資質
r2: r2 -> r1  ; L3 %天才によって規則を生み出したこと
r3: f2 -> -r4  ; L8 %それ自体に目的を持たないにもかかわらず合目的的に感じられること（不成立の根拠）
r4: r4 -> r3  ; L7 %目的なき合目的性が備えていること
r5: f3 -> -r6  ; L12 %多くの思考を引き起こすが、それに完全に対応する特定の概念によって規定されない（不成立の根拠）
r6: r6 -> r5  ; L11 %美的理念を有する
r7: r1 & r3 & r5 -> x1  ; AND
r8: -r4 -> -r3  ; L8 は L7 の定義（言い換え）なので、定義の不成立は被定義項の不成立。mext.py は r4 -> r3 だけを作り、-r4 から -r3 を作らない
r9: -r6 -> -r5  ; L12 は L11 の定義なので同上
r10: -r3 -> -k1  ; L2 の ~> は「美しい芸術」の定義（3要件の連言）で、各要件は必要条件。mext.py は ~> の内容を原子にしていない（落ちている）ので、必要条件であることをここで補う
r11: -r5 -> -k1  ; 同上（第3要件の必要条件性）

[defaults]
L1: x1 : k1 / k1  ; claim L1 主張 ^カントの判断力批判
L1.不成立: ⊤ : -k1, -k1 / -k1  ; failure L15 主張 L1 が成立しないことからの結論

[priority]

[extensions]
; 衝突しうるデフォルト: L1
E1:
  generating: L1.不成立
  literals: -k1, r1, r2, f1, -r3, -r4, f2, -r5, -r6, f3

[marks]
+ r2     L5 %芸術に規則を与える生得的な心的資質  ; E1:一致
+ r1     L3 %天才によって規則を生み出したこと  ; E1:一致
! r3     L7 %目的なき合目的性が備えていること  ; E1:一致
! r5     L11 %美的理念を有する  ; E1:一致

[summary]
extensions: 1
skeptical: -k1
credulous: -k1
