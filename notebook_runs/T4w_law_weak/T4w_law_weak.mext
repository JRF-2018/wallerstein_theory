f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11

[rules]
r1: v1 -> r1  ; wage_core:L6 %雇用が不安定
r2: -v1 -> -r1  ; wage_core:L6 %雇用が不安定（必要条件の否定）
r3: -r1 -> -k1  ; wage_core:L4 要件の否定による主張 補償原則_中核 の不成立
r4: v2 -> -r2  ; wage_core:L12 %慣習が成立している（不成立の根拠）
r5: v3 -> -r3  ; wage_core:L14 %慣習による意思がある（不成立の根拠）
r6: r2 & r3 -> x1  ; AND
r7: -r2 -> -x1  ; AND（必要条件の否定）
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -x1 -> -k2  ; wage_core:L10 要件の否定による主張 身分秩序_中核 の不成立
r10: v4 -> -r4  ; wage_core:L19 %慣行が続いている（不成立の根拠）
r11: -r4 -> -k3  ; wage_core:L18 要件の否定による主張 実態_中核 の不成立
r12: v5 -> r5  ; wage_periphery:L6 %雇用が不安定
r13: -v5 -> -r5  ; wage_periphery:L6 %雇用が不安定（必要条件の否定）
r14: -r5 -> -k4  ; wage_periphery:L4 要件の否定による主張 補償原則_周辺 の不成立
r15: v6 -> r6  ; wage_periphery:L12 %慣習が成立している
r16: -v6 -> -r6  ; wage_periphery:L12 %慣習が成立している（必要条件の否定）
r17: v7 -> r7  ; wage_periphery:L14 %慣習による意思がある
r18: -v7 -> -r7  ; wage_periphery:L14 %慣習による意思がある（必要条件の否定）
r19: r6 & r7 -> x2  ; AND
r20: -r6 -> -x2  ; AND（必要条件の否定）
r21: -r7 -> -x2  ; AND（必要条件の否定）
r22: -x2 -> -k5  ; wage_periphery:L10 要件の否定による主張 身分秩序_周辺 の不成立
r23: v8 -> r8  ; wage_periphery:L19 %慣行が続いている
r24: -v8 -> -r8  ; wage_periphery:L19 %慣行が続いている（必要条件の否定）
r25: -r8 -> -k6  ; wage_periphery:L18 要件の否定による主張 実態_周辺 の不成立
r26: v9 -> r10  ; law_periphery_weak:L8 「職務の内容が通常の労働者と同一」
r27: -v9 -> -r10  ; law_periphery_weak:L8 「職務の内容が通常の労働者と同一」（必要条件の否定）
r28: v10 -> r11  ; law_periphery_weak:L10 「職務の内容及び配置の変更の範囲が通常の労働者と同一の範囲で変更されると見込まれる」
r29: -v10 -> -r11  ; law_periphery_weak:L10 「職務の内容及び配置の変更の範囲が通常の労働者と同一の範囲で変更されると見込まれる」（必要条件の否定）
r30: r10 & r11 -> x3  ; AND
r31: -r10 -> -x3  ; AND（必要条件の否定）
r32: -r11 -> -x3  ; AND（必要条件の否定）
r33: x3 -> r9  ; law_periphery_weak:L6 「通常の労働者と同視すべき短時間・有期雇用労働者」
r34: -x3 -> -r9  ; law_periphery_weak:L6 「通常の労働者と同視すべき短時間・有期雇用労働者」（必要条件の否定）
r35: -r9 -> -k7  ; law_periphery_weak:L5 要件の否定による主張 均等待遇_周辺 の不成立
r36: v11 -> -r12  ; law_periphery_weak:L17 %実効的な執行（不成立の根拠）
r37: -r12 -> -k8  ; law_periphery_weak:L15 要件の否定による主張 均等待遇の実効_周辺 の不成立

[defaults]
e1: f2 : v1, r1 / v1  ; eval wage_core:L6 評価 @危険を負っている
補償原則_中核: f1, r1 : k1, -c1 / k1, -c1  ; claim wage_core:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e2: f3 : v2, -r2 / v2  ; eval wage_core:L12 評価 @慣習は成立していない
e3: f4 : v3, -r3 / v3  ; eval wage_core:L14 評価 @労働者は身分賃金を受け入れない
身分秩序_中核: f1, x1 : k2 / k2  ; claim wage_core:L10 主張 ^民法92条（事実たる慣習）
身分秩序_中核.不成立: ⊤ : -k2, c2 / c2  ; failure wage_core:L15 主張 身分秩序_中核 が成立しないことからの結論
e4: f3 : v4, -r4 / v4  ; eval wage_core:L19 評価 @身分秩序の慣行はない
実態_中核: f1, r4 : k3 / k3  ; claim wage_core:L18 主張 ^Sim3の観測
実態_中核.不成立: ⊤ : -k3, c3 / c3  ; failure wage_core:L20 主張 実態_中核 が成立しないことからの結論
e5: f6 : v5, r5 / v5  ; eval wage_periphery:L6 評価 @危険を負っている
補償原則_周辺: f5, r5 : k4, -c4 / k4, -c4  ; claim wage_periphery:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e6: f7 : v6, r6 / v6  ; eval wage_periphery:L12 評価 @慣習が成立している
e7: f8 : v7, r7 / v7  ; eval wage_periphery:L14 評価 @労働者は身分賃金を受け入れる
身分秩序_周辺: f5, x2 : k5, c4, -ab1 / k5, c4  ; claim wage_periphery:L10 主張 ^民法92条（事実たる慣習）
e8: f7 : v8, r8 / v8  ; eval wage_periphery:L19 評価 @身分秩序の慣行が続いている
実態_周辺: f5, r8 : k6, c5, -ab2 / k6, c5  ; claim wage_periphery:L18 主張 ^Sim3の観測
e9: f9 : v9, r10 / v9  ; eval law_periphery_weak:L8 評価 @正規と同じ職務を担っている（AI: 疑わしい）
e10: f10 : v10, r11 / v10  ; eval law_periphery_weak:L10 評価 @配置の変更の範囲が同一（AI: 疑わしい）
均等待遇_周辺: f5, r9 : k7, -c4 / k7, -c4, ab1  ; claim law_periphery_weak:L5 主張 ^パート有期法9条（強行規定）
e11: f11 : v11, -r12 / v11  ; eval law_periphery_weak:L17 評価 @身分秩序は慣性で続く
均等待遇の実効_周辺: f5, r12 : k8 / k8, ab2  ; claim law_periphery_weak:L15 主張 ^パート有期法9条の執行
均等待遇の実効_周辺.不成立: ⊤ : -k8, c6 / c6  ; failure law_periphery_weak:L18 主張 均等待遇の実効_周辺 が成立しないことからの結論

[priority]
