ab1    ab     "ab(身分秩序_周辺)"

[W]
f1, f2, f3, f4, f5, f6, f7, f8, f9

[rules]
r1: v1 -> r1  ; wage_core:L6 %雇用が不安定
r2: -v1 -> -r1  ; wage_core:L6 %雇用が不安定（必要条件の否定）
r3: -r1 -> -k1  ; wage_core:L4 要件の否定による主張 補償原則_中核 の不成立
r4: v2 -> -r2  ; wage_core:L11 %慣習が成立している（不成立の根拠）
r5: v3 -> -r3  ; wage_core:L13 %労働者が身分賃金を受け入れる（不成立の根拠）
r6: r2 & r3 -> x1  ; AND
r7: -r2 -> -x1  ; AND（必要条件の否定）
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -x1 -> -k2  ; wage_core:L9 要件の否定による主張 身分秩序_中核 の不成立
r10: v1 -> r4  ; wage_periphery:L6 %雇用が不安定
r11: -v1 -> -r4  ; wage_periphery:L6 %雇用が不安定（必要条件の否定）
r12: -r4 -> -k3  ; wage_periphery:L4 要件の否定による主張 補償原則_周辺 の不成立
r13: v4 -> r5  ; wage_periphery:L11 %慣習が成立している
r14: -v4 -> -r5  ; wage_periphery:L11 %慣習が成立している（必要条件の否定）
r15: v5 -> r6  ; wage_periphery:L13 %労働者が身分賃金を受け入れる
r16: -v5 -> -r6  ; wage_periphery:L13 %労働者が身分賃金を受け入れる（必要条件の否定）
r17: r5 & r6 -> x2  ; AND
r18: -r5 -> -x2  ; AND（必要条件の否定）
r19: -r6 -> -x2  ; AND（必要条件の否定）
r20: -x2 -> -k4  ; wage_periphery:L9 要件の否定による主張 身分秩序_周辺 の不成立
r21: v6 -> r7  ; law_periphery_weak:L5 「通常の労働者と同視すべき短時間・有期雇用労働者」
r22: -v6 -> -r7  ; law_periphery_weak:L5 「通常の労働者と同視すべき短時間・有期雇用労働者」（必要条件の否定）
r23: v7 -> -r8  ; law_periphery_weak:L7 %実効的な執行（不成立の根拠）
r24: r7 & r8 -> x3  ; AND
r25: -r7 -> -x3  ; AND（必要条件の否定）
r26: -r8 -> -x3  ; AND（必要条件の否定）
r27: -x3 -> -k5  ; law_periphery_weak:L4 要件の否定による主張 均衡待遇_周辺 の不成立

[defaults]
e1: f2 : v1, r1 / v1  ; eval wage_core:L6 評価 @危険を負っている
補償原則_中核: f1, r1 : k1, -c1 / k1, -c1  ; claim wage_core:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e2: f3 : v2, -r2 / v2  ; eval wage_core:L11 評価 @慣習は成立していない
e3: f4 : v3, -r3 / v3  ; eval wage_core:L13 評価 @受け入れない
身分秩序_中核: f1, x1 : k2 / k2  ; claim wage_core:L9 主張 ^民法92条（事実たる慣習）
身分秩序_中核.不成立: ⊤ : -k2, c2 / c2  ; failure wage_core:L14 主張 身分秩序_中核 が成立しないことからの結論
e4: f2 : v1, r4 / v1  ; eval wage_periphery:L6 評価 @危険を負っている
補償原則_周辺: f5, r4 : k3, -c3 / k3, -c3  ; claim wage_periphery:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e5: f6 : v4, r5 / v4  ; eval wage_periphery:L11 評価 @慣習が成立している
e6: f7 : v5, r6 / v5  ; eval wage_periphery:L13 評価 @受け入れる（AI: 疑わしい）
身分秩序_周辺: f5, x2 : k4, c3, -ab1 / k4, c3  ; claim wage_periphery:L9 主張 ^民法92条（事実たる慣習）
e7: f8 : v6, r7 / v6  ; eval law_periphery_weak:L5 評価 @職務の内容と配置の変更の範囲が同一（AI: 疑わしい）
e8: f9 : v7, -r8 / v7  ; eval law_periphery_weak:L7 評価 @身分秩序は慣性で続く
均衡待遇_周辺: f5, x3 : k5 / k5, ab1  ; claim law_periphery_weak:L4 主張 ^パート有期法9条
均衡待遇_周辺.不成立: ⊤ : -k5, c4 / c4  ; failure law_periphery_weak:L8 主張 均衡待遇_周辺 が成立しないことからの結論
強行規定_9条: r7 : ab1 / ab1  ; extra [extra] 試算: パート有期法9条は強行規定であり、執行の実効がなくても私法上の効力（差別的取扱いの禁止）を持つ。民法92条の事実たる慣習は任意規定と異なる場合にしか働かない

[priority]
均衡待遇_周辺 > 均衡待遇_周辺.不成立
均衡待遇_周辺 > 身分秩序_周辺
強行規定_9条 > 身分秩序_周辺
身分秩序_中核 > 身分秩序_中核.不成立
身分秩序_周辺 > 補償原則_周辺

[extensions]
; 衝突しうるデフォルト: 身分秩序_中核, 補償原則_周辺, 身分秩序_周辺, 均衡待遇_周辺
E1 preferred:
  generating: e1, 補償原則_中核, e2, e3, 身分秩序_中核.不成立, e4, 補償原則_周辺, e5, e6, e7, e8, 均衡待遇_周辺.不成立, 強行規定_9条
  literals: k1, f1, r1, f2, v1, -c1, -k2, -r2, f3, v2, -r3, f4, v3, -x1, c2, k3, f5, r4, -c3, r5, f6, v4, r6, f7, v5, x2, -k5, r7, f8, v6, -r8, f9, v7, -x3, c4, ab1

[marks]
! r2     wage_core:L11 %慣習が成立している  ; E1:一致
! r3     wage_core:L13 %労働者が身分賃金を受け入れる  ; E1:一致
! k2     wage_core:L9 #身分秩序  ; E1:一致
+ r5     wage_periphery:L11 %慣習が成立している  ; E1:一致
+ r6     wage_periphery:L13 %労働者が身分賃金を受け入れる  ; E1:一致
+ k4     wage_periphery:L9 #身分秩序  ; E1:不一致
+ r7     law_periphery_weak:L5 「通常の労働者と同視すべき短時間・有期雇用労働者」  ; E1:一致
! r8     law_periphery_weak:L7 %実効的な執行  ; E1:一致
! k5     law_periphery_weak:L4 #均衡待遇の実効  ; E1:一致

[summary]
extensions: 1 (preferred: 1)
skeptical: k1, -c1, -k2, c2, k3, -c3, -k5, c4
credulous: k1, -c1, -k2, c2, k3, -c3, -k5, c4
