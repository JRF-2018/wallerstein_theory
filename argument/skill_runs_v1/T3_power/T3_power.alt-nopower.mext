@mext 1
theory: wage_core.matcha
theory: wage_periphery.matcha
; MEXT: Matcha EXTension notation（本レポートの考案）。書式は docs/mext.md を参照。

[ai]
; AI（または人）の判断。各行の ; 以降に理由を書く。
;   same "代表の文言" "同じ意味の文言"
;   neg  "文言A" "文言B"        … B は A の否定
;   failure "文言" / effect "文言" … 結論を「不成立からの帰結」「成立の効果」と読む
;   review "事実@評価" ok|doubtful|reject
review "非正規の層は契約の切れ目で0.2の割合で職がない@危険を負っている" ok  ; 契約の切れ目ごとに2割が職を失うのは、雇用の不安定（失職の危険）の典型的な事実。中核・周辺で同じ e0 を使うのは Sim 2 の設定どおり
review "成立した契約のうち身分秩序によるものの割合は0である@慣習は成立していない" ok  ; 誰も従っていない行動様式は「事実たる慣習」になりえない
review "身分賃金2.209は正規職の列に並ぶ価値2.548を下回る@受け入れない" ok  ; 外部機会（列に並ぶ価値）を下回る申し出を断るのは参加制約の通常の読み
review "成立した契約のうち身分秩序によるものの割合は0.978である@慣習が成立している" ok  ; 97.8% の契約が従う行動様式は慣習の事実的な基礎として十分。ただし民法92条の他の要件（公序に反しないこと等）は要件に挙がっていない（§6）
review "身分賃金0.629は正規職の列に並ぶ価値0.563を上回る@受け入れる" ok  ; 数値上は外部機会を上回るので受け入れるのが合理的。外部機会が低いこと自体が力関係の帰結である点は「受け入れ」の任意性を争う余地として §8 に挙げる（あてはめ自体の飛躍ではない）

[extra]
;   fact "文言" / rule "a" & "b" -> "c" / default 名: "a" : "b" / "b" / priority 名1 > 名2

[claimed]
観測*: -"非正規の賃金は正規より低くてよい〔中核の非正規の労働契約〕", "非正規の賃金は正規より低くてよい〔周辺の非正規の労働契約〕"  ; Sim 3 で観測された慣行（中核 B 0%、周辺 B 97%）
AI予測1*: "身分秩序_周辺", "非正規の賃金は正規より低くてよい〔周辺の非正規の労働契約〕", "補償原則_中核", -"非正規の賃金は正規より低くてよい〔中核の非正規の労働契約〕", -"身分秩序_中核", "中核では身分秩序による賃金の切り下げは認められない〔中核の非正規の労働契約〕"  ; 周辺では両主張の前提が揃って c3 で衝突し、:: 優先 により身分秩序が勝つ。中核では身分秩序の要件が否定され、補償原則だけが働く
AI予測2: "補償原則_周辺", -"非正規の賃金は正規より低くてよい〔周辺の非正規の労働契約〕", !"身分秩序_周辺"  ; 優先を無視すれば補償原則が先に働く世界もありうる（preferred ではない）

; ===== ここから下は mext.py が自動生成（手で直さない） =====
[atoms]
k1     claim  "#補償原則^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）"  ; wage_core:L4
f1     fact   "中核の非正規の労働契約"  ; wage_core:L4,wage_core:L9
r1     req    "補償原則_中核／%雇用が不安定"  ; wage_core:L6
f2     fact   "非正規の層は契約の切れ目で0.2の割合で職がない"  ; wage_core:L6,wage_periphery:L6
v1     eval   "非正規の層は契約の切れ目で0.2の割合で職がない@危険を負っている"  ; wage_core:L6,wage_periphery:L6
c1     concl  "非正規の賃金は正規より低くてよい〔中核の非正規の労働契約〕"  ; wage_core:L7
k2     claim  "#身分秩序^民法92条（事実たる慣習）"  ; wage_core:L9
r2     req    "身分秩序_中核／%慣習が成立している"  ; wage_core:L11
f3     fact   "成立した契約のうち身分秩序によるものの割合は0である"  ; wage_core:L11
v2     eval   "成立した契約のうち身分秩序によるものの割合は0である@慣習は成立していない"  ; wage_core:L11
r3     req    "身分秩序_中核／%労働者が身分賃金を受け入れる"  ; wage_core:L13
f4     fact   "身分賃金2.209は正規職の列に並ぶ価値2.548を下回る"  ; wage_core:L13
v3     eval   "身分賃金2.209は正規職の列に並ぶ価値2.548を下回る@受け入れない"  ; wage_core:L13
x1     aux    "（wage_core:L9 の AND・2項・1）"  ; wage_core:L9
c2     concl  "中核では身分秩序による賃金の切り下げは認められない〔中核の非正規の労働契約〕"  ; wage_core:L14
k3     claim  "#補償原則^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986） [補償原則_周辺]"  ; wage_periphery:L4
f5     fact   "周辺の非正規の労働契約"  ; wage_periphery:L4,wage_periphery:L9
r4     req    "補償原則_周辺／%雇用が不安定"  ; wage_periphery:L6
c3     concl  "非正規の賃金は正規より低くてよい〔周辺の非正規の労働契約〕"  ; wage_periphery:L7,wage_periphery:L14
k4     claim  "#身分秩序^民法92条（事実たる慣習） [身分秩序_周辺]"  ; wage_periphery:L9
r5     req    "身分秩序_周辺／%慣習が成立している"  ; wage_periphery:L11
f6     fact   "成立した契約のうち身分秩序によるものの割合は0.978である"  ; wage_periphery:L11
v4     eval   "成立した契約のうち身分秩序によるものの割合は0.978である@慣習が成立している"  ; wage_periphery:L11
r6     req    "身分秩序_周辺／%労働者が身分賃金を受け入れる"  ; wage_periphery:L13
f7     fact   "身分賃金0.629は正規職の列に並ぶ価値0.563を上回る"  ; wage_periphery:L13
v5     eval   "身分賃金0.629は正規職の列に並ぶ価値0.563を上回る@受け入れる"  ; wage_periphery:L13
x2     aux    "（wage_periphery:L9 の AND・2項・1）"  ; wage_periphery:L9

[W]
f1, f2, f3, f4, f5, f6, f7

[rules]
r1: v1 -> r1  ; wage_core:L6 %雇用が不安定
r2: -v1 -> -r1  ; wage_core:L6 %雇用が不安定（必要条件の否定）
r3: -r1 -> -k1  ; wage_core:L4 要件の否定による主張 補償原則_中核 の不成立
r4: v2 -> -r2  ; wage_core:L11 %慣習が成立している（不成立の根拠）
r5: v3 -> -r3  ; wage_core:L13 %労働者が身分賃金を受け入れる（不成立の根拠）
r6: r2 & r3 -> x1  ; AND
r7: -r2 -> -x1  ; AND（必要条件の否定）
r8: -r3 -> -x1  ; AND（必要条件の否定）
r9: -x1 -> -k2  ; wage_core:L9 要件の否定による主張 身分秩序_中核 の不成立
r10: v1 -> r4  ; wage_periphery:L6 %雇用が不安定
r11: -v1 -> -r4  ; wage_periphery:L6 %雇用が不安定（必要条件の否定）
r12: -r4 -> -k3  ; wage_periphery:L4 要件の否定による主張 補償原則_周辺 の不成立
r13: v4 -> r5  ; wage_periphery:L11 %慣習が成立している
r14: -v4 -> -r5  ; wage_periphery:L11 %慣習が成立している（必要条件の否定）
r15: v5 -> r6  ; wage_periphery:L13 %労働者が身分賃金を受け入れる
r16: -v5 -> -r6  ; wage_periphery:L13 %労働者が身分賃金を受け入れる（必要条件の否定）
r17: r5 & r6 -> x2  ; AND
r18: -r5 -> -x2  ; AND（必要条件の否定）
r19: -r6 -> -x2  ; AND（必要条件の否定）
r20: -x2 -> -k4  ; wage_periphery:L9 要件の否定による主張 身分秩序_周辺 の不成立

[defaults]
e1: f2 : v1, r1 / v1  ; eval wage_core:L6 評価 @危険を負っている
補償原則_中核: f1, r1 : k1, -c1 / k1, -c1  ; claim wage_core:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e2: f3 : v2, -r2 / v2  ; eval wage_core:L11 評価 @慣習は成立していない
e3: f4 : v3, -r3 / v3  ; eval wage_core:L13 評価 @受け入れない
身分秩序_中核: f1, x1 : k2 / k2  ; claim wage_core:L9 主張 ^民法92条（事実たる慣習）
身分秩序_中核.不成立: ⊤ : -k2, c2 / c2  ; failure wage_core:L14 主張 身分秩序_中核 が成立しないことからの結論
e4: f2 : v1, r4 / v1  ; eval wage_periphery:L6 評価 @危険を負っている
補償原則_周辺: f5, r4 : k3, -c3 / k3, -c3  ; claim wage_periphery:L4 主張 ^補償賃金差の原則（Smith『国富論』第1編第10章、Rosen 1986）
e5: f6 : v4, r5 / v4  ; eval wage_periphery:L11 評価 @慣習が成立している
e6: f7 : v5, r6 / v5  ; eval wage_periphery:L13 評価 @受け入れる
身分秩序_周辺: f5, x2 : k4, c3 / k4, c3  ; claim wage_periphery:L9 主張 ^民法92条（事実たる慣習）

[priority]
身分秩序_中核 > 身分秩序_中核.不成立

[extensions]
; 衝突しうるデフォルト: 身分秩序_中核, 補償原則_周辺, 身分秩序_周辺
E1 preferred:
  generating: e1, 補償原則_中核, e2, e3, 身分秩序_中核.不成立, e4, 補償原則_周辺, e5, e6
  literals: k1, f1, r1, f2, v1, -c1, -k2, -r2, f3, v2, -r3, f4, v3, -x1, c2, k3, f5, r4, -c3, r5, f6, v4, r6, f7, v5, x2
E2 preferred:
  generating: e1, 補償原則_中核, e2, e3, 身分秩序_中核.不成立, e4, e5, e6, 身分秩序_周辺
  literals: k1, f1, r1, f2, v1, -c1, -k2, -r2, f3, v2, -r3, f4, v3, -x1, c2, f5, r4, c3, k4, r5, f6, v4, r6, f7, v5, x2

[marks]
! r2     wage_core:L11 %慣習が成立している  ; E1:一致 E2:一致
! r3     wage_core:L13 %労働者が身分賃金を受け入れる  ; E1:一致 E2:一致
! k2     wage_core:L9 #身分秩序  ; E1:一致 E2:一致
+ r5     wage_periphery:L11 %慣習が成立している  ; E1:一致 E2:一致
+ r6     wage_periphery:L13 %労働者が身分賃金を受け入れる  ; E1:一致 E2:一致
+ k4     wage_periphery:L9 #身分秩序  ; E1:不一致 E2:一致

[summary]
extensions: 2 (preferred: 2)
skeptical: k1, -c1, -k2, c2
credulous: k1, -c1, -k2, c2, k3, c3, -c3, k4
